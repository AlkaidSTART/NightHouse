      "bytes": 43267
    },
    {
      "clipId": "VO_Narrator_npc_arthur_confront_mercy_L03",
      "text": "他挽起左袖。手腕内侧的抓痕从手背滑向掌心。",
      "source": "assets/audio/vo/vo_narrator/source_flash_xuyuyuan/VO_Narrator_npc_arthur_confront_mercy_L03.wav",
      "runtime": "public/assets/audio/vo/VO_Narrator_npc_arthur_confront_mercy_L03.ogg",
