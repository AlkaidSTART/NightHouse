    },
    {
      "clipId": "VO_Narrator_npc_arthur_refuse_01_L01",
      "text": "亚瑟看着你，没有去碰那支笔。",
      "source": "assets/audio/vo/vo_narrator/source_flash_xuyuyuan/VO_Narrator_npc_arthur_refuse_01_L01.wav",
      "runtime": "public/assets/audio/vo/VO_Narrator_npc_arthur_refuse_01_L01.ogg",
      "durationSeconds": 3.6,
      "bytes": 28992
    },
    {
      "clipId": "VO_Narrator_npc_housekeeper_letter_b1_L01",
      "text": "你把那封盖着「无法投递」印戳的信递给她。",
