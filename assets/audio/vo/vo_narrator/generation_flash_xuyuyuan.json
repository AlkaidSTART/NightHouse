    },
    {
      "clipId": "VO_Narrator_npc_arthur_dinner_watch_L01",
      "text": "亚瑟看着右手边的空椅子，手指在桌布边缘轻轻敲击。",
      "source": "assets/audio/vo/vo_narrator/source_flash_xuyuyuan/VO_Narrator_npc_arthur_dinner_watch_L01.wav",
