    {
      "clipId": "VO_NpcDoctor_npc_doctor_motive_01_L01",
      "variant": "base",
      "text": "我不是替他瞒。我是替她瞒。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_motive_01_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_motive_01_L01.ogg",
