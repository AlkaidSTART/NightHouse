      "bytes": 23073
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_motive_01_L02",
      "variant": "base",
      "text": "一个未婚女子半夜死在男人书房里，报纸会怎么写她？我想让她至少被写成一个意外。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_motive_01_L02.wav",
