    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_time_01_L01",
      "variant": "base",
      "text": "……午夜前后。具体记不清了。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_time_01_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_time_01_L01.ogg",
