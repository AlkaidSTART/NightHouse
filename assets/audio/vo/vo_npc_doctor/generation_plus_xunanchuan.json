      "bytes": 18432
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_intro_R01_MISS",
      "variant": "miss",
      "text": "还有哪里不舒服吗，小姐？",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_intro_R01_MISS.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_intro_R01_MISS.ogg",
