      "bytes": 18470
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_summer_01_L01",
      "variant": "base",
      "text": "那年夏天你在这儿住了两个月。伊芙琳带你去看潮。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_summer_01_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_summer_01_L01.ogg",
      "durationSeconds": 4.2,
      "bytes": 41979
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_summer_01_L02",
      "variant": "base",
      "text": "她那时候就喜欢一个人往崖边跑。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_summer_01_L02.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_summer_01_L02.ogg",
      "durationSeconds": 2.16,
      "bytes": 21214
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_purpose_L01",
      "variant": "base",
      "text": "不用客气，先生。算是见证吧——也是来看看亚瑟，他这一年睡得不好。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_purpose_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_purpose_L01.ogg",
