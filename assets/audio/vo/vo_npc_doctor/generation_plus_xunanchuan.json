      "bytes": 40844
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_sleep_L02",
      "variant": "base",
      "text": "……我是说，悲伤。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_sleep_L02.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_sleep_L02.ogg",
