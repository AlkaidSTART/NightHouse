    {
      "clipId": "VO_NpcDoctor_npc_doctor_sleep_L01",
      "variant": "base",
      "text": "良心和神经是两回事，但从症状上很难分开。",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_sleep_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_sleep_L01.ogg",
