      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_intro_L02.ogg",
      "durationSeconds": 2.64,
      "bytes": 25519
    },
    {
      "clipId": "VO_NpcDoctor_npc_doctor_intro_R01",
      "variant": "base",
      "text": "还有哪里不舒服吗，先生？",
      "source": "assets/audio/vo/vo_npc_doctor/source_plus_xunanchuan/VO_NpcDoctor_npc_doctor_intro_R01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcDoctor_npc_doctor_intro_R01.ogg",
