      "bytes": 29801
    },
    {
      "clipId": "VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L02",
      "variant": "base",
      "text": "二楼最里面她的房间一直锁着，备用钥匙我还替她收在围裙口袋里。",
      "source": "assets/audio/vo/vo_npc_housekeeper/source_plus_longanlingxin/VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L02.wav",
      "runtime": "public/assets/audio/vo/VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L02.ogg",
