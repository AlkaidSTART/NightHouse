    {
      "clipId": "VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L01",
      "variant": "base",
      "text": "小姐待下人很好。她教我认字。",
      "source": "assets/audio/vo/vo_npc_housekeeper/source_plus_longanlingxin/VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L01.wav",
      "runtime": "public/assets/audio/vo/VO_NpcHousekeeper_npc_housekeeper_evelyn_b5_L01.ogg",
